# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Apple's public root CA cert (not a secret) - required at runtime to verify
# App Store Server Notifications, so it's tracked despite the *.pem rule above.
!app/core/certs/AppleRootCA-G3.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
server.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# misc files
.env
.env.local
.env.*.local
*.zip

# user-generated/runtime data
/public/uploads/*
!/public/uploads/.htaccess
/storage/logs/*
!/storage/logs/.gitkeep
